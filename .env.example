# ─────────────────────────────────────────────────────────────────────────────
# Agents, Everywhere — starter kit environment
#
#   cp .env.example .env      then fill in MODEL PROVIDER and you can already run.
#
# Replace the selected provider's placeholder with your own key. Each app
# reports missing configuration when the relevant integration is used.
# ─────────────────────────────────────────────────────────────────────────────


# ── MODEL PROVIDER · choose one ──────────────────────
# Choose one chat provider explicitly: openai or openrouter.
# OpenAI: https://platform.openai.com/api-keys
MODEL_PROVIDER=openai
OPENAI_API_KEY=stub-replace-me
MODEL=gpt-5.6-sol

# To use OpenRouter instead, change MODEL_PROVIDER=openrouter, set its key,
# and choose a model from https://openrouter.ai/models (publisher/model).
# No OpenAI key is required for OpenRouter chat.
# Get a key: https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# MODEL=openai/gpt-5.6-sol

# ── SILENTOPS · Gemini as a provider ───────────────────
# SilentOps supports google as a first-class provider on both sides of the
# fallback (packages/loop-core/src/model/with-fallback.ts). BuiltInAgent resolves
# a "google:<model>" string through createGoogleGenerativeAI with GOOGLE_API_KEY,
# so no gateway or extra install is involved.
#
# To make Gemini the primary model:
#   MODEL_PROVIDER=google        (gemini and google-gemini are accepted aliases)
#   MODEL=gemini-2.5-flash       (a REAL Gemini id — see the caveat below)
#   GOOGLE_API_KEY=...
#
# Caveat that costs an hour if missed: with MODEL_PROVIDER=google and a bare
# MODEL like `gpt-4.1`, nothing errors — the request goes out as
# `google:gpt-4.1` and fails at the API as an unknown model. Always set MODEL to
# a Gemini id when the provider is google.
#
# FALLBACK_MODEL is REQUIRED whenever the fallback provider is google, because
# the fallback hop only swaps the provider and would otherwise ask Gemini for the
# primary's model name. withFallback throws a named error if it is missing.
# FALLBACK_MODEL=gemini-2.5-flash
# GOOGLE_API_KEY=
# With MODEL_PROVIDER unset, an OpenRouter key selects OpenRouter; otherwise
# a MODEL provider prefix selects that provider, defaulting to OpenAI.
# Existing anthropic/ and google/ model prefixes remain supported with their
# ANTHROPIC_API_KEY and GOOGLE_API_KEY respectively. See dev-docs/model-switching.md.
# Browser voice uses OpenAI Realtime independently of chat, so set
# OPENAI_API_KEY before opening /voice.


# ── SLACK TEMPLATE · managed Channels connection ────────
# Intelligence hosts the provider webhook and dials THIS process over an
# outbound websocket, so you need no ngrok and no public URL of your own.
#
# Fastest path — let your coding agent drive the consoles:
#   npx copilotkit@latest channels setup
#
# Or by hand:
#   1. Create the Channel FIRST (the wizard generates a Slack app manifest
#      already pointed at the right request URL):
#        npx copilotkit@latest channels add --name my-agent \
#          --display-name "My Agent" --adapter slack --json
#   2. Copy the Channel *Code* into CHANNEL_CODE below — it must match
#      character for character (lowercase, digits, single hyphens).
#   3. Create a project-scoped key under API Keys in the Intelligence sidebar.
#      It looks like `cpk-{projectId}_...` — the runtime parses the project id
#      out of it, and Channel activation fails with ChannelConfigError if the
#      format is wrong.
INTELLIGENCE_API_KEY=
CHANNEL_CODE=

# Lifecycle breadcrumbs are emitted at `warn` while the runtime logger defaults
# to `error`. Leave this at debug while you are getting connected, or you will
# never see `channel "<name>" requires setup`.
LOG_LEVEL=debug

# HTTP port. Managed deliveries arrive over the Channel's own socket, not this
# port — but most hosts want something listening for their health check.
PORT=3000

# Only for self-hosted / non-production Intelligence. Separate hosts: override
# BOTH or NEITHER, as bare base URLs. Never derive one from the other.
# INTELLIGENCE_API_URL=
# INTELLIGENCE_GATEWAY_WS_URL=


# ── OPTIONAL TOOLS · use what your template needs ──────────────────────────────────────

# Exa — grounded web search as an agent tool. Without this the search tool is
# not registered at all, and the agent is told it has no web access.
# Get a key: https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# Exa search profile. `instant` (~250ms) and `fast` (~450ms) are the only sane
# choices inside a chat thread. `deep-reasoning` takes up to 40s and reads as
# broken in Slack.
EXA_SEARCH_TYPE=fast

# Ambiguous AI — a 17-app workplace (mail, tasks, CRM, docs, calendar) the agent
# can actually act in, over MCP. Set this and the agent gains those tools and is
# told it has them; leave it unset and it is never offered them at all.
# Use your demo workspace Connect instructions: https://www.ambiguous.ai/auth.md
# Full sponsor setup and first calls: using-sponsor-tools.md
# AMBIGUOUS_API_KEY=

# Web approval metadata needs persistent disk (not task storage).
# Defaults to apps/web/.data/web-approvals when run with npm run dev:web.
# Keep the approval server on loopback unless you add your own auth and
# trusted-origin boundary.
# WEB_APPROVAL_DIR=/absolute/path/to/web-approvals


# ── CONTROL TOWER · the /console shift review in apps/web ──────────────────────
# The control tower is a read-only review surface. It is gated by a single shared
# hub access code, verified server-side and exchanged for an HttpOnly session
# cookie. The gate FAILS CLOSED: with no code set, /console redirects to /access
# and nobody gets in. There is no default and no bypass.
# CONSOLE_ACCESS_CODE=

# Signing key for the console session cookie. Optional: without it a random key
# is generated per process, so restarting the app signs everyone out. Set it to
# keep sessions across restarts. Use a long random value, not the access code.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# CONSOLE_SESSION_SECRET=
